
# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem      1.0
PortGroup       compilers 1.0

name            epl-hdrl-devel
set __name      hdrl
version         1.6.0
categories      science
license         GPL-2+
# AUTHORS BUGS COPYING NEWS LICENSE: not in current hdrl tarball (add to EXTRA_DIST
# in Makefile.am in a future hdrl release); then consider installing to share/doc if desired.
platforms       darwin
maintainers     @JohnPritchard
description     ESO High Level Datareduction Library (HDRL)
long_description HDRL is an ESO C library for astronomical data reduction. \
                 It provides algorithms for image combination, bad-pixel \
                 handling, flat-fielding, spectroscopy, and related tasks. \
                 HDRL depends on CPL, GSL, ERFA, and libcurl.
homepage        https://www.eso.org/sci/software/cpl
master_sites    https://ftp.eso.org/pub/dfs/pipelines/libraries/${__name}
distname        ${__name}-${version}
checksums       sha256 647cb40200f612013abda2964a4b66cf170a07afa586fc118ff4107462b93378

depends_lib     port:epl-cpl-devel port:curl port:erfa port:gsl

configure.args  --enable-standalone \
                --with-cpl=${prefix} \
                --with-erfa=${prefix} \
                --with-gsl=${prefix} \
                --with-libcurl=${prefix}
depends_build-append  port:pkgconfig

test.run        yes
test.target     installcheck
