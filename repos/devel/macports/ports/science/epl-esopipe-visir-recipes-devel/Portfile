# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
# $Id$
PortSystem      1.0
PortGroup      compilers 1.0

set instrument  visir
set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/epl/devel
name            epl-esopipe-${instrument}-recipes-devel
set __name esopipe-${instrument}-recipes
#conflicts       esopipe-${instrument}-recipes-devel
set pl_version         4.6.4
version         4.6.4-5
revision      0
categories      science
license         GPL-2+
platforms       darwin
maintainers     @JohnPritchard
homepage        http://www.eso.org/sci/software/pipelines/
description     ESO VISIR instrument pipeline (recipe plugins)
long_description ESO data reduction pipeline recipe plugins for the VISIR instrument. \
                 See www.eso.org/pipelines for a description of the ESO pipeline systems. \
                 To execute these one needs to install a front-end such as esorex or Reflex.
master_sites    https://ftp.eso.org/pub/dfs/pipelines/kit_devel
distname        ${instrument}-kit-${version}

compilers.choose  cc cpp cxx fc
compilers.setup   gcc clang
configure.install   ${__prefix}/bin/ginstall

dist_subdir     epl-esopipe-${instrument}
checksums       sha256 c5566f1c5f618ca5a73a626a33df45d7e7e469e847d08d0b9fe0e09da421118d

worksrcdir          ${instrument}-${pl_version}
extract.post_args   "| tar -xf - ${distname}/${instrument}-${pl_version}.tar.gz"

post-extract {
    system "tar -xzf ${workpath}/${distname}/${instrument}-${pl_version}.tar.gz -C ${workpath}"
    system "rm -rf ${workpath}/${distname}"
}

pre-patch {
    reinplace "s|cpl_check_cpl_lib=\"libcplcore.la\"|cpl_check_cpl_lib=\"libcplcore.a\"|" ${workpath}/${instrument}-${pl_version}/configure
}

depends_build   port:pkgconfig
depends_lib     port:epl-cfitsio-devel port:epl-esorex-devel port:curl port:erfa port:gsl

configure.args  --with-cfitsio=${prefix} \
                --with-cpl=${prefix} \
                --with-erfa=${__prefix} \
                --with-gsl=${__prefix}

post-destroot {
    if {[file exists ${filespath}/setup_wkf_dirs] == 1} {
        system "find ${destroot}${prefix}/share/reflex/workflows/${instrument}-${pl_version} -name \*.xml -exec sh ${filespath}/setup_wkf_dirs ${prefix} ${instrument} {}  \; "
        system "find ${destroot}${prefix}/share/esopipes/${instrument}-${pl_version}/reflex -name \*.xml -exec sh ${filespath}/setup_wkf_dirs ${prefix} ${instrument} {}  \; "
    } else {
        return -code error "Problem with Portfile, missing ${filespath}/setup_wkf_dirs!"
    }
}

use_parallel_build  no


if {[clang_variant_isset]} {
  configure.ldflags-append "-I/opt/local/include/libomp -L/opt/local/lib/libomp"
}


variant O2 description "Set optimisation level to -O2, (Macports default is Os)" {
  configure.optflags  -O2
}


variant O3 description "Set optimisation level to -O3, (Macports default is Os)" {
  configure.optflags  -O3
}


variant debug description "Set optimisation level to -O0 for debugging, (Macports default is Os)" {
  depends_lib-delete port:epl-cpl-devel
  depends_lib-delete port:epl-cext-devel
  configure.args-delete --with-cpl=${__prefix}
  configure.args-append "--with-cpl-includes=/include --with-cpl-libs=/.libs"
  configure.optflags  -O0 -g
}


if {[clang_variant_isset] || [gcc_variant_isset]} {
  default_variants +O3
}


if {[variant_isset gccdevel] || [variant_isset gcc12]} {
  configure.ldflags-append "-stdlib=${configure.cxx_stdlib}"
}

test.run            yes
test.target         installcheck

variant ld_classic description "Use the classic linker" {
  configure.ldflags-append "-ld_classic"
}

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# ${instrument}-kit-${version}
# or
# ${instrument}-kit-${version}-N
livecheck.url       https://www.eso.org/sci/software/pipe_aem_table.html
#livecheck.url       https://ftp.eso.org/pub/dfs/pipelines/repositories/devel/kit/reflex_cfg/reflex_devel.txt
livecheck.regex     ${instrument}-kit-(\[0-9.-\]+)${extract.suffix}

## SWarp version incompatible with Xcode-15
variant use_mp_swarp description "Use swarp from EPL-MacPorts" {
  depends_lib-append   port:epl-swarp
  #configure.args-append   --no-recursion
  post-extract {
    reinplace "s@^.*swarp.*@#&@" ${worksrcpath}/configure.ac
    reinplace "s@swarp@@" ${worksrcpath}/Makefile.am
    reinplace "s@ eval swarp_bin=.*@ eval swarp_bin=${prefix}/bin@" ${worksrcpath}/acinclude.m4
  }
  use_autoreconf      yes
  autoreconf.args     -fiv
  #post-destroot {
  #  xinstall -d -m 0755 ${destroot}/${prefix}/lib/${instrument}-${version}/bin
  #  ln -s /opt/local/bin/swarp ${destroot}/${prefix}/lib/${instrument}-${version}/bin/swarp
  #}
}
default_variants +use_mp_swarp

post-extract {
  reinplace "s|_POSIX_SOURCE|&_dont|"  ${worksrcpath}/swarp/src/wcs/tnx.c
  reinplace "s|_POSIX_SOURCE|&_dont|"  ${worksrcpath}/swarp/src/fitswcs.c
}
