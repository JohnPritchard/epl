PortGroup        select 1.0

name             pyesorex_select
version          1.0.0
revision         3
categories       science
supported_archs  noarch
platforms        darwin
maintainers      eso.org:usd-help
description      common files for selecting the default pyesorex version
long_description This port installs files that allow 'port select' \
                 to be used to create links to the preferred default \
                 version of pyesorex.



post-destroot {
    select::install pyesorex ${filespath}/base
    select::install pyesorex ${filespath}/none
}

livecheck.type  none
test.run        no
