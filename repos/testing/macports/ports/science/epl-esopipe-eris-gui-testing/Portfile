# $Id$
PortSystem      1.0

set instrument  eris
set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/epl/testing
name            epl-esopipe-${instrument}-gui-testing
set __name esopipe-${instrument}-gui
#conflicts       esopipe-${instrument}-gui-devel
version         1.9.0
revision      1
 categories      science
license         GPL-2+
platforms       darwin
maintainers     eso.org:usd-help
homepage        http://www.eso.org/sci/software/pipelines/
description     ESO ERIS instrument pipeline (graphical execution)
long_description ESO data reduction pipeline for the ERIS instrument. \
                 See www.eso.org/pipelines for a description of the ESO pipeline systems. \
                 This meta-package contains all necessary dependencies to run \
                 the pipeline in a graphical way with Reflex.
master_sites
distfiles

depends_run     port:epl-esopipe-${instrument}-datademo \
                port:epl-esopipe-${instrument}-datastatic \
                port:epl-esopipe-${instrument}-wkf


use_configure   no
build           {}
destroot        {
    xinstall -m 755 -d ${destroot}${prefix}/share/doc/esopipes-${instrument}-gui
    system "echo ${long_description} > ${destroot}${prefix}/share/doc/esopipes-${instrument}-gui/README.txt"
}

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# ${instrument}-kit-${version}
# or
# ${instrument}-kit-${version}-N
livecheck.url       https://www.eso.org/sci/software/pipe_aem_table.html
#livecheck.url       https://ftp.eso.org/pub/dfs/pipelines/repositories/testing/kit/reflex_cfg/reflex_testing.txt
livecheck.regex     ${instrument}-kit-(\[0-9.-\]+)${extract.suffix}
