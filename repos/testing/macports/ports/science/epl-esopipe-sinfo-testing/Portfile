# $Id$
PortSystem      1.0

set instrument  sinfo
set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/epl/testing
name            epl-esopipe-${instrument}-testing
set __name esopipe-${instrument}
#conflicts       esopipe-${instrument}-devel
version         3.3.6-12
revision       0
categories      science
license         GPL-2+
platforms       darwin
maintainers     @JohnPritchard
homepage        http://www.eso.org/sci/software/pipelines/
description     ESO SINFONI instrument pipeline (text terminal execution)
long_description ESO data reduction pipeline for the SINFONI instrument. \
                 See www.eso.org/pipelines for a description of the ESO pipeline systems. \
                 This meta-package contains all necessary dependencies to run \
                 the pipeline on the terminal with esorex.
master_sites
distfiles

depends_run     port:epl-esopipe-${instrument}-datastatic-testing \
                port:epl-esopipe-${instrument}-recipes-testing \
                port:epl-esorex-testing


use_configure   no
build           { }
destroot        {
                xinstall -m 755 -d ${destroot}${prefix}/share/doc/esopipes-${instrument}
                system "echo ${long_description} > ${destroot}${prefix}/share/doc/esopipes-${instrument}/README.txt"
}

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# ${instrument}-kit-${version}
# or
# ${instrument}-kit-${version}-N
livecheck.url       https://www.eso.org/sci/software/pipe_aem_table.html
#livecheck.url       https://ftp.eso.org/pub/dfs/pipelines/repositories/testing/kit/reflex_cfg/reflex_testing.txt
livecheck.regex     ${instrument}-kit-(\[0-9.-\]+)${extract.suffix}
