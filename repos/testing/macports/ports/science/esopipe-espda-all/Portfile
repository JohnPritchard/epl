# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
# $Id$
PortSystem      1.0

set instrument  espda
set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/eso/testing/cpl-7.3.2
name            esopipe-${instrument}-all-testing
set __name esopipe-${instrument}-all
set __nd__name [strsed ${__name} g/-devel//]
#conflicts       esopipe-${instrument}-all-devel
version         1.4.0
revision       2
categories      science
license         GPL-2+
platforms       darwin
maintainers     @JohnPritchard
homepage        http://www.eso.org/sci/software/pipelines/
description     ESO ESPRESSO-DAS instrument pipeline (all packages)
long_description ESO data reduction pipeline for the ESPRESSO-DAS instrument. \
                 See www.eso.org/pipelines for a description of the ESO pipeline systems. \
                 This meta-package will install all the packages related \
                 to the pipeline, including demo data, static data and \
                 workflows.
master_sites
distfiles

depends_run     port:esopipe-${instrument}-testing port:esopipe-${instrument}-gui-testing


use_configure   no
build           {}
destroot        {
    xinstall -m 755 -d ${destroot}${prefix}/share/doc/esopipes-${instrument}-all
    system "echo ${long_description} > ${destroot}${prefix}/share/doc/esopipes-${instrument}-all/README.txt"
}

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# ${instrument}-kit-${version}
# or
# ${instrument}-kit-${version}-N
livecheck.url https://www.eso.org/sci/software/pipe_aem_table.html
livecheck.regex     ${instrument}-kit-(\[0-9.-\]+)${extract.suffix}
