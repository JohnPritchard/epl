# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           python 1.0
PortGroup           select 1.0

set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/epl/stable
name                epl-edps
set __name edps
version             1.8.1
revision      0
categories          science
license             MIT
supported_archs     noarch
platforms           darwin

maintainers         @JohnPritchard

description         EDPS data processing system
long_description    EDPS is a system to automatically organise data from ESO instruments \
                    for pipeline processing and running the pipeline on these data.

homepage            https://www.eso.org/sci/software/edps.html

master_sites        https://ftp.eso.org/pub/dfs/pipelines/libraries/edps
distname            ${__name}-${version}
checksums           rmd160 33335b76639d8b271d68d49ed98294582ce61846 \
                    sha256 7fdac7954460768cd97372b28e0b10db6976b1f924103a5afcf22c3e43aee7bb

# Workaround to ensure that each version of macOS produces a different
# binary and they don't clash in the package pool
platforms       darwin


# Generate a single package edps that uses the python 3.13 stack
python.default_version  314
python.pep517       yes
python.pep517_backend   setuptools

## Isolate the epl channel installations
destroot.destdir    --destdir ${destroot} --prefix ${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}

depends_run-append  \
                    port:py${python.default_version}-jinja2 \
                    port:py${python.default_version}-tinydb \
                    port:py${python.default_version}-frozendict \
                    port:py${python.default_version}-networkx \
                    port:py${python.default_version}-requests \
                    port:py${python.default_version}-pydantic \
                    port:py${python.default_version}-uvicorn \
                    port:py${python.default_version}-fastapi \
                    port:py${python.default_version}-psutil \
                    port:py${python.default_version}-astropy

post-destroot {
    xinstall -g wheel -m 755 -d ${prefix}/bin
    xinstall -g wheel -m 755 -d ${destroot}${__prefix}/bin

    reinplace "s@import sys@&\\nsys.path.insert(0, \"${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/\")@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps
    ln -s ${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps ${destroot}${prefix}/bin/edps
    ln -s ${prefix}/bin/edps ${destroot}${__prefix}/bin/epl-edps

    reinplace "s@import sys@&\\nsys.path.insert(0, \"${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/\")@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps-server
    ln -s ${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps-server ${destroot}${prefix}/bin/edps-server
    ln -s ${prefix}/bin/edps-server ${destroot}${__prefix}/bin/epl-edps-server

    reinplace "s@import sys@&\\nsys.path.insert(0, \"${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/\")@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps-shutdown
    ln -s ${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/bin/edps-shutdown ${destroot}${prefix}/bin/edps-shutdown
    ln -s ${prefix}/bin/edps-shutdown ${destroot}${__prefix}/bin/epl-edps-shutdown

    reinplace "s@edps-server@epl-edps-server@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/scripts/client.py
    reinplace "s@{self.home}/.edps@{self.home}/.epl-edps@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/config/configuration.py
    reinplace "s@\".edps\"@\".epl-edps\"@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/generator/LocalJobGenerator.py
    reinplace "s@'esorex'@'epl-esorex'@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/config/configuration.py
    reinplace "s@'genreport'@'epl-genreport'@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/config/configuration.py
    reinplace "s@int, 5000@int, 5100@" \
        ${destroot}${prefix}/Library/Frameworks/Python.framework/Versions/${python.branch}/lib/python${python.branch}/site-packages/edps/config/configuration.py
}
