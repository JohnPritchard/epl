PortSystem         1.0
PortGroup          github 1.0
PortGroup          compilers 1.0

github.setup        astromatic sextractor 2.28.2
github.tarball_from archive
github.setup        astromatic sextractor c011a00e38325817d8cd3c47be07386d7d957213 20260619
#version             20260619
maintainers         @JohnPritchard

set __name          sextractor
name                epl-${__name}
set __prefix        ${prefix}
set prefix          ${__prefix}/libexec/epl/stable

categories         science
platforms          darwin
maintainers        @JohnPritchard
license            CeCILL

description        SExtractor stands for ``Source Extractor'': a software for extracting catalogs of sources from astronomical images.

long_description   SExtractor stands for ``Source Extractor'': a software for extracting catalogs of sources from astronomical images.

homepage            https://github.com/astromatic/sextractor
master_sites        https://github.com/astromatic/sextractor/archive
distname            ${version}
checksums           md5     0fb171588c5b36fed6efa9bfcc174822 \
                    sha1    0c184c478d39d20fbffe4e092b7a94e59ccf1ea0 \
                    rmd160  765e486b3fead52ca88af369430b348cfaa02158 \
                    sha256  f228183314724b59b5278b16fb9d62179bf89b0d8d30c86d3bc5aa25d50d0e0a \
                    size    2692042

depends_lib        port:fftw-3 \
                   port:fftw-3-single \
                   port:OpenBLAS \

use_autoreconf      yes
autoreconf.args     -fiv

set worksrcpath ${workpath}/sextractor-${version}

pre-configure {
    reinplace "s@LM_FINITE finite@LM_FINITE isfinite@" "${worksrcpath}/src/levmar/compiler.h"
}

configure.fc       ${prefix}/bin/no-possible-compiler
configure.cflags-append {*}${configure.cppflags}
if {[vercmp ${xcodeversion} >= 15.0] && [gcc_variant_isset]} {
    configure.ldflags-append -ld_classic
}
configure.args     --prefix=${prefix} \
                    --with-fftw-libdir=${__prefix}/lib \
                    --with-fftw-incdir=${__prefix}/include \
                    --enable-openblas \
                    --with-openblas-libdir=${__prefix}/lib \
                    --with-openblas-incdir=${__prefix}/include/openblas \

post-destroot {
    set docdir ${destroot}${prefix}/share/doc
    xinstall -d ${docdir}
    copy ${worksrcpath}/doc ${docdir}/${name}
    xinstall -m 644 -W ${worksrcpath} \
        README.md \
        AUTHORS \
        COPYRIGHT \
        ChangeLog \
        BUGS \
        HISTORY \
        THANKS \
        ${docdir}/${name}
}

livecheck.type     regex
livecheck.url      [lindex ${master_sites} 0]
livecheck.regex    ${name}-(\[0-9.\]+)\\.tar
