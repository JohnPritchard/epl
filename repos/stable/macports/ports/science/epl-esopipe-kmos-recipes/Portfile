# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
# $Id$
PortSystem      1.0
PortGroup      compilers 1.0

set instrument  kmos
set __prefix  ${prefix}
set prefix    ${__prefix}/libexec/epl/stable
name            epl-esopipe-${instrument}-recipes
set __name esopipe-${instrument}-recipes
#conflicts       esopipe-${instrument}-recipes-devel
set pl_version 4.5.3
version         4.5.3-6
revision      0
 categories      science
license         GPL-2+
platforms       darwin
maintainers     eso.org:usd-help
homepage        http://www.eso.org/sci/software/pipelines/
description     ESO KMOS instrument pipeline (recipe plugins)
long_description ESO data reduction pipeline recipe plugins for the KMOS instrument. \
                 See www.eso.org/pipelines for a description of the ESO pipeline systems. \
                 To execute these one needs to install a front-end such as esorex or Reflex.
master_sites    https://ftp.eso.org/pub/dfs/pipelines/instruments/${instrument}
distname        ${instrument}-kit-${version}

compilers.choose  cc cpp cxx fc
compilers.setup   gcc clang
configure.install   ${__prefix}/bin/ginstall

dist_subdir epl-esopipe-${instrument}_stable
checksums       sha256 ce0797eb5624ed68535903691e0675ff84be612e48957020bcf40768ec9f67de

worksrcdir          ${instrument}-${pl_version}
extract.post_args   "| tar -xf - ${distname}/${instrument}-${pl_version}.tar.gz"

post-extract {
    system "tar -xzf ${workpath}/${distname}/${instrument}-${pl_version}.tar.gz -C ${workpath}"
    system "rm -rf ${workpath}/${distname}"
}

depends_build   port:pkgconfig
depends_lib     port:epl-esorex port:epl-telluriccorr

configure.args  --with-cpl=${prefix} --with-telluriccorr=${__prefix}

post-destroot {
    system "cd ${worksrcpath}/reflex && make DESTDIR=${destroot} uninstall"
    system "cd ${worksrcpath}/reports && make DESTDIR=${destroot} uninstall"
    #system "cd ${worksrcpath}/workflows && make DESTDIR=${destroot} uninstall"
}

use_parallel_build  no


if {[clang_variant_isset]} {
  configure.ldflags-append "-I/opt/local/include/libomp -L/opt/local/lib/libomp"
}


variant O2 description "Set optimisation level to -O2, (Macports default is Os)" {
  configure.optflags  -O2
}


variant O3 description "Set optimisation level to -O3, (Macports default is Os)" {
  configure.optflags  -O3
}


variant debug description "Set optimisation level to -O0 for debugging, (Macports default is Os)" {
  depends_lib-delete port:epl-cpl
  depends_lib-delete port:epl-cext
  configure.args-delete --with-cpl=${__prefix}
  configure.args-append "--with-cpl-includes=/include --with-cpl-libs=/.libs"
  configure.optflags  -O0 -g
}


if {[clang_variant_isset] || [gcc_variant_isset]} {
  default_variants +O3
}


if {[variant_isset gccdevel] || [variant_isset gcc12]} {
  configure.ldflags-append "-stdlib=${configure.cxx_stdlib}"
}

test.run            yes
test.target         installcheck

variant ld_classic description "Use the classic linker" {
  configure.ldflags-append "-ld_classic"
}

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# ${instrument}-kit-${version}
# or
# ${instrument}-kit-${version}-N
livecheck.url       https://www.eso.org/sci/software/pipe_aem_table.html
#livecheck.url       https://ftp.eso.org/pub/dfs/pipelines/repositories/stable/kit/reflex_cfg/reflex_stable.txt
livecheck.regex     ${instrument}-kit-(\[0-9.-\]+)${extract.suffix}
