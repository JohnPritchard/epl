variant force_omp description "Force the enabling OpenMP, otherwise with MP gcc/clang we get seg' faults." {
  post-extract {
    reinplace "s| \&\& \!defined( *__APPLE__ *)||"  \${worksrcpath}/hdrl/hdrl_utils.h
