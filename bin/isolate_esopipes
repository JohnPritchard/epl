                cat >> ${P}/Portfile <<EOF

# This is not quite right because kit versions can be either x.y.z or x.y.z-N
# while the version is always x.y.z and the distname is either
# \${instrument}-kit-\${version}
# or
# \${instrument}-kit-\${version}-N
livecheck.url       https://www.eso.org/sci/software/pipe_aem_table.html
#livecheck.url       https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt
livecheck.regex     \${instrument}-kit-(\[0-9.-\]+)\${extract.suffix}
EOF
              fi

              ## Use a non-default version of python...???
              if [ ! -z "${ESOPIPE_PY_VER}" ]; then
                py_ver=${ESOPIPE_PY_VER//.}
                if [[ "$P" =~ "-wkf" ]]; then
                  if ! grep py${py_ver} ${P}/Portfile >/dev/null 2>&1 ; then
                    printf "%-40s %s\n" "[${release_channel}.${P}]" "Setting python version to python-${ESOPIPE_PY_VER} in $P..."
                    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
                        -e 's/py[0-9][0-9]*-/py${py_ver}-/g' \
                      ${P}/Portfile"
                    #if [[ ${py_ver} -ge 310 ]]; then
                    #  echo "Using py-epl-wxpython-4.0 in $P..."
                    #  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
                    #      -e 's/py[0-9][0-9]*-wxpython/py${py_ver}-epl-wxpython/g' \
                    #    ${P}/Portfile"
                    #fi
                  fi
                fi
                if [[ "$P" =~ "esoreflex" ]]; then
                  if ! grep py${py_ver} ${P}/Portfile >/dev/null 2>&1 ; then
                    printf "%-40s %s\n" "[${release_channel}.${P}]" "Setting python version to python-${ESOPIPE_PY_VER} in $P..."
                    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
                        -e 's/python[0-9][0-9]*/python${py_ver}/g' \
                        -e 's/python[0-9][0-9]*\.[0-9][0-9]*/python${ESOPIPE_PY_VER}/g' \
                        -e 's/py[0-9][0-9]*-/py${py_ver}-/g' \
                      ${P}/Portfile"
                  fi
                fi
              fi

              ## For the moment [2021-01-13], sphere is the latest package requiring the cpl-patch
              ## But the molecfit & kmos packages still require the telluriccorr-patch
              ## The mtime on the sphere-wkf Portfile is "Jul 24 23:23:01 2020"/"Jul 24 23:33:09 2020"
              # stat -f %m $(port file esopipe-spher-recipes) = 1595625781
              # stat -f %m $(port file esopipe-spher-wkf)     = 1595626389
              ## The mtime on the esopipe-molecfit-wkf Portfile is "Sep  5 18:25:33 2020"
              # gdate +%s -d "Sep  5 18:25:33 2020" = 1599323133
              ## The mtime on the esopipe-kmos-wkf Portfile is "Sep  8 12:52:45 2020"
              # gdate +%s -d "Sep  8 12:52:45 2020" = 1599562365
              if ( \
                  [[ $st_mtime -le 1599562365 ]] || \
                  [[ "$P" =~ "-adetmon-" ]] || \
                  [[ "$P" =~ "-akmos-" ]] || \
                  [[ "$P" =~ "-amolecfit-" ]] || \
                  [[ "$P" =~ "-agiraf-" ]] || \
                  [[ "$P" =~ "-asinfo-" ]] || \
                  [[ "$P" == "aesopipe-uves-wkf${_ns}" ]] || \
                  [[ "$P" =~ "-axshoo-" ]] || \
                  [[ "$P" =~ "atelluriccorr" ]] || \
                  false \
                ) \
                ; then
                if ( \
                    [[ "$P" =~ "-wkf" ]] || \
                    [[ "$P" =~ "-recipes" ]] || \
                    [[ "$P" =~ "esorex" ]] || \
                    [[ "$P" =~ "telluriccorr" ]] || \
                    false \
                  ) && ( \
                    [[ ! "$P" =~ "-esotk-" ]] && \
                    true \
                  ) \
                  ; then
                  m4dir="m4macros"
                  unset cpl_m4s
                  if \
                      [[ "$P" =~ "-giraf-" ]] || \
                      [[ "$P" =~ "-muse-" ]] || \
                      [[ "$P" =~ "esorex" ]] || \
                      false \
                    ; then
                    m4dir="m4"
                  elif \
                      [[ "$P" =~ "-spher-" ]] || \
                      false \
                    ; then
                    m4dir="config/m4macros"
                  elif \
                      [[ "$P" =~ "-visir-" ]] || \
                      false \
                    ; then
                    cpl_m4s="swarp/acx_cpl.m4"
                  fi
                  [ ! -d ${P}/files ] && execCmd "mkdir ${P}/files"
                  if ( \
                      [[ $st_mtime -le 1595626389 ]] || \
                      [[ "$P" =~ "-detmon-" ]] || \
                      [[ "$P" =~ "-giraf-" ]] || \
                      [[ "$P" =~ "-sinfo-" ]] || \
                      [[ "$P" == "esopipe-uves-wkf${_ns}" ]] || \
                      [[ "$P" =~ "-xshoo-" ]] || \
                      false \
                    ) \
                    ; then
                    printf "%-40s %s\n" "[${release_channel}.${P}]" "**** Applying cpl-m4-fix to $P ****"
                    for PF in ${cpl_m4s:-${m4dir:-m4macros}/cpl.m4}  ; do
                      cat > ${P}/files/${PF//\//_} <<EOF
--- ${PF}.orig	2020-07-30 10:55:14.000000000 +0200
+++ ${PF}	2020-07-30 11:03:22.000000000 +0200
@@ -110,6 +110,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                        #include <\$cpl_cfitsio_check_header>
                        ]],
                        [
                         float v;
@@ -487,6 +488,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                        #include <cxutils.h>
                        ]],
                        [
                         cx_program_set_name("MyProgram");
@@ -669,6 +671,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                        #include <\$cpl_wcs_check_header>
                        ]],
                        [
                         wcsini(0, 1, (void *)0);
@@ -955,6 +958,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                        #include <\$cpl_fftw_check_header>
                        ]],
                        [
                         fftw_plan_dft_1d(0, (void *)0, (void *)0, 0, 0);
@@ -1189,6 +1193,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                        #include <\$cpl_fftw_check_header>
                        ]],
                        [
                         fftwf_plan_dft_1d(0, (void *)0, (void *)0, 0, 0);
@@ -1520,6 +1525,7 @@
     
         AC_LINK_IFELSE([AC_LANG_PROGRAM(
                        [[
+                       #include <\$cpl_check_header>
                        ]],
                        [
                         cpl_init(0);
EOF
                    cat >>${P}/Portfile <<EOF

patchfiles-append     ${PF//\//_}
EOF
                    done
                  fi
                  if \
                    [[ "$P" =~ "-akmos-" ]] || \
                    [[ "$P" =~ "-amolecfit-" ]] || \
                    false \
                    ; then
                    printf "%-40s %s\n" "[${release_channel}.${P}]" "**** Applying telluriccorr-m4-fix to $P ****"
                    mkdir -pv ${P}/files
                    cat > ${P}/files/ <<EOF
--- ${m4dir:-m4macros}/telluriccorr.m4.orig	2019-04-05 07:42:06.000000000 +0200
+++ ${m4dir:-m4macros}/telluriccorr.m4	2020-07-30 13:46:36.000000000 +0200
