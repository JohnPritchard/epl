#! /bin/sh

if false ; then
sudo port list requested | grep ^esopipe
sudo port uninstall esopipe-\* cpl cext esorex esoreflex telluriccorr cfitsio
# To control the default PL compiler...
sudo /opt/epl/bin/epl.update.ports --clean_eso_repos
sudo /opt/epl/bin/epl.update.ports --no_isolate_esopipes --no_cleanup --no_upgrade_outdated
# then one of the following...
sudo \
APPLE_CLANG_AS_DEFAULT=true \
bash /opt/epl/bin/isolate_esopipes --py 3.13

#DEFAULT_COMPILER=\${compilers.gcc_default} \
sudo \
APPLE_CLANG_AS_DEFAULT=false \
DEFAULT_COMPILER=clang21 \
bash /opt/epl/bin/isolate_esopipes --py 3.13

# For fors, hawki & visir...
#ALT_DEFAULT_COMPILER=clang21
sudo \
APPLE_CLANG_AS_DEFAULT=false \
ALT_DEFAULT_COMPILER=gcc15 \
bash /opt/epl/bin/isolate_esopipes --py 3.13

sudo rsync -avx /opt/epl/eso_macports/cfitsio/ /opt/local/var/macports/sources/rsync.macports.org/macports/release/tarballs/ports/science/cfitsio/
sudo rsync -avx /opt/epl/eso_macports/stable/ /opt/local/var/macports/sources/ftp.eso.org/pub/dfs/pipelines/repositories/stable/
sudo rsync -avx /opt/epl/eso_macports/testing/ /opt/local/var/macports/sources/ftp.eso.org/pub/dfs/pipelines/repositories/testing/
sudo rsync -avx /opt/epl/eso_macports/devel/ /opt/local/var/macports/sources/piperepo.hq.eso.org/devel/

fi

## "@(#) $Id: isolate_esopipes 3734 2021-02-16 11:46:12Z jpritcha $"

################################################################################
## Definition of functions
usage() {
  printf "\
Usage: ${execName} [-h|Dvnq]

  -h|--help: help
  -D|--debug: debug
  -n|--dryRun: dry-run
  -q|--quiet: quiet
     -q Only Warnings and Errors are written out (to stderr)
     -q -q increases quietness, only Errors are written out (to stderr)
     -q -q -q increases quietness, NO output to stdout or stderr
  -v|--verbose: verbose

  --py) e.g. 3.13
"
  exit ${exstat:-0}
}

################################################################################
## Definition of variable who need default values
execName="`basename ${0}`"
quietLevel=0

APPLE_CLANG_AS_DEFAULT=${APPLE_CLANG_AS_DEFAULT:-true}

################################################################################
## Generic utility functions
if [ -z "${EPL_FUNCTIONS_READLINK}" ]; then
  EPL_FUNCTIONS_READLINK="readlink"
  which greadlink > /dev/null 2>&1 && EPL_FUNCTIONS_READLINK="greadlink"
fi
[ -z "${EPL_FUNCTIONS}" ] && EPL_FUNCTIONS="$(dirname $(${EPL_FUNCTIONS_READLINK} -f ${0}))/epl.functions.sh"
if [ -e ${EPL_FUNCTIONS:-/opt/epl/bin/epl.functions.sh} ]; then
  . ${EPL_FUNCTIONS:-/opt/epl/bin/epl.functions.sh}
else
  echo "${execName}::Error:: ${EPL_FUNCTIONS:-/opt/epl/bin/epl.functions.sh} does NOT exist"
  exit 1
fi

################################################################################
## Local functions definitions
add_compiler_variants() {
  if ( \
      [[ ! "$P" =~ "-aspher" ]] && \
      true \
    ) ; then
    if ! grep '^PortGroup[[:space:]]*compilers' ${P}/Portfile > /dev/null 2>&1 ; then
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's@^PortSystem\(\s\s*\).*@&__ret__PortGroup\1compilers 1.0@' \
        -e 's@^checksums@__ret__compilers.choose  cc cpp cxx fc__ret__compilers.setup   gcc clang__ret__configure.install   \${__prefix}/bin/ginstall__ret____ret__&@' \
        -e 's[__ret__[\\n[g' \
        ${P}/Portfile"
    else
      # For PLs that are already using gcc (UVES)
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/-clang/clang/' \
        ${P}/Portfile"
    fi
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's@^test.run@\\nif {[clang_variant_isset]} {\\n  configure.ldflags-append \"-I/opt/local/include/libomp -L/opt/local/lib/libomp\"\\n}\\n\\n&@' \
      ${P}/Portfile"
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's@^test.run@\\nvariant O2 description \"Set optimisation level to -O2, (Macports default is Os)\" {\\n  configure.optflags  -O2\\n}\\n\\n&@' \
      ${P}/Portfile"
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's@^test.run@\\nvariant O3 description \"Set optimisation level to -O3, (Macports default is Os)\" {\\n  configure.optflags  -O3\\n}\\n\\n&@' \
      ${P}/Portfile"
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's@^test.run@\\nvariant debug description \"Set optimisation level to -O0 for debugging, (Macports default is Os)\" {\\n  configure.optflags  -O0 -g\\n}\\n\\n&@' \
      ${P}/Portfile"
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's/^test.run/\\nif {[clang_variant_isset] || [gcc_variant_isset]} {\\n  default_variants +O3\\n}\\n\\n&/' \
      ${P}/Portfile"
    execCmd "${EPL_FUNCTIONS_SED} ${meye} \
      -e 's/^test.run/\\nif {[variant_isset gccdevel] || [variant_isset gcc12]} {\\n  configure.ldflags-append \"-stdlib=\${configure.cxx_stdlib}\"\\n}\\n\\n&/' \
      ${P}/Portfile"
    cat >>${P}/Portfile <<EOF

variant ld_classic description "Use the classic linker" {
  configure.ldflags-append "-ld_classic"
}
EOF
    if ( \
        [[ "$P" =~ "-afors"  ]] || \
        [[ "$P" =~ "-ahawki" ]] || \
        [[ "$P" =~ "-aspher" ]] || \
        [[ "$P" =~ "-avimos" ]] || \
        false \
      ) ; then
      cat >>${P}/Portfile <<EOF
## As at 2023-09-24, Need to use the old linker with Xcode-15 when compiling with gccXX,
## at least for fors, hawki and vimos
if {[vercmp \${xcodeversion} >= 15.0] && [gcc_variant_isset]} {
  default_variants +ld_classic
}
EOF
    fi
    if ! ${APPLE_CLANG_AS_DEFAULT:-false}; then
      if ! grep '^default_variants' ${P}/Portfile > /dev/null 2>&1 ; then
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e \"s@^compilers.setup@default_variants  +${DEFAULT_COMPILER:-\\\${compilers.gcc_default}}\\n&@\" \
          ${P}/Portfile"
      fi
      ## Some pipelines don't compile with gcc...
      ## As 2023-07-05 fors seems to be ok with mp-gcc12
      ## And now as of 2023-09-22, fors once again fails with mp-gcc12
      ## On the otherhand, as of 2023-09-22, spher compiles with mp-gcc12
      ## Use -ld_classic workaround...
      if ( \
          [[ "$P" =~ "-afors"  ]] || \
          [[ "$P" =~ "-ahawki" ]] || \
          [[ "$P" =~ "-aspher" ]] || \
          [[ "$P" =~ "-avimos" ]] || \
          false \
        ) ; then
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e \"s@\\\${compilers.gcc_default}@${ALT_DEFAULT_COMPILER:-clang21}@\" \
          ${P}/Portfile"
        printf "%-40s %s\n" "[${release_channel}.${P}]" "Adding compiler variants, default compiler set to ${ALT_DEFAULT_COMPILER:-clang21}"
      else
        printf "%-40s %s\n" "[${release_channel}.${P}]" "Adding compiler variants, default compiler set to ${DEFAULT_COMPILER:-\${compilers.gcc_default}}"
      fi
    else
      printf "%-40s %s\n" "[${release_channel}.${P}]" "Adding compiler variants"
    fi
    if ( \
        [[ "$P" =~ "cext" ]] || \
        false \
      ) ; then
      ### CEXT
      debugLog "[${release_channel}.${P}] : Doing nothing..."
    else
      if [ -z "${_cext_version}" ]; then
        _cext_version=$(grep ^version[[:space:]] $D/macports/ports/${category}/cext/Portfile | awk '{print $2}')
      fi
if false ; then
      #     D=/opt/local/var/macports/sources/ftp.eso.org/pub/dfs/pipelines/repositories/stable
      #cext_workD=/opt/local/var/macports/build/_opt_local_var_macports_sources_ftp.eso.org_pub_dfs_pipelines_repositories_stable_macports_ports_science_cext/cext/work/cext-1.2.4/cext/.libs/
      # cpl_workD=/opt/local/var/macports/build/_opt_local_var_macports_sources_ftp.eso.org_pub_dfs_pipelines_repositories_stable_macports_ports_science_cpl/cpl/work
      _cextD=${D/\/sources\/*/\/build\/}${D//\//_}_macports_ports_${category}_cext/cext/work/cext-${_cext_version[0]}/cext
      _cplD=${D/\/sources\/*/\/build\/}${D//\//_}_macports_ports_${category}_cpl/\${name}/work/cpl-${_cpl_version[0]}
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's@^variant debug.*@&__ret__  configure.args-delete --with-system-cext__ret__  configure.args-delete --with-cext=\\\${__prefix}__ret__  configure.args-append \"--with-cext-includes=${_cextD} --with-cext-libs=${_cextD}/.libs\"@' \
        -e 's[__ret__[\\n[g' \
        ${P}/Portfile"
fi
      if ( \
          [[ "$P" =~ "cpl" ]] || \
          false \
        ) ; then
        ### CPL
        printf "%-40s %s\n" "[${release_channel}.${P}]" "fixing ginstall & threads..."
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@\${__prefix}/bin/ginstall@\${prefix}/bin/ginstall@' \
          -e 's/^test.run/variant reentrant description \"Enable threads\" {\\n  configure.args-delete --disable-threads\\n}\\n\\n&/' \
          ${P}/Portfile"
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's/^test.run/\\nif {[clang_variant_isset] || [gcc_variant_isset]} {\\n  default_variants +reentrant\\n}\\n\\n&/' \
          ${P}/Portfile"
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@^variant debug.*@&__ret__  post-build {__ret__    xinstall -d ${_cplD}/include__ret__    xinstall -d ${_cplD}/.libs__ret__    xinstall {*}[glob ${_cextD}/*.h] ${_cplD}/include__ret__    xinstall {*}[glob ${_cplD}/*.h] ${_cplD}/include__ret__    xinstall {*}[glob ${_cplD}/*/*.h] ${_cplD}/include__ret__    xinstall {*}[glob ${_cplD}/*/.libs/*] ${_cplD}/.libs__ret__  }@' \
          -e 's[__ret__[\\n[g' \
          ${P}/Portfile"
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@^variant debug.*@&__ret__  depends_lib-delete port:cext@' \
          -e 's[__ret__[\\n[g' \
          ${P}/Portfile"
      else
        ### ESOREX, ESOPIE-*-RECIPES...
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@^variant debug.*@&__ret__  configure.args-delete --with-cpl=\${__prefix}__ret__  configure.args-append \"--with-cpl-includes=${_cplD}/include --with-cpl-libs=${_cplD}/.libs\"@' \
          -e 's[__ret__[\\n[g' \
          ${P}/Portfile"
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@^variant debug.*@&__ret__  depends_lib-delete port:cext@' \
          -e 's[__ret__[\\n[g' \
          ${P}/Portfile"
        execCmd "${EPL_FUNCTIONS_SED} ${meye} \
          -e 's@^variant debug.*@&__ret__  depends_lib-delete port:cpl@' \
          -e 's[__ret__[\\n[g' \
          ${P}/Portfile"
        #for cplD in cpl{dfs,ui,core,drs} ; do
        #  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        #    -e 's@^variant debug.*@&__ret__  configure.ldflags-append -L${_cplD}/${cplD}/.libs@' \
        #    -e 's[__ret__[\\n[g' \
        #    ${P}/Portfile"
        #done
      fi
    fi
    #if ( \
    #    [[ "$P" =~ "esorex" ]] || \
    #    [[ "$P" =~ "-fors" ]] || \
    #    [[ "$P" =~ "-hawki" ]] || \
    #    [[ "$P" =~ "-vimos" ]] || \
    #    false \
    #  ) ; then
    #  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
    #    -e 's@\${compilers.gcc_default}@clang21@' \
    #    ${P}/Portfile"
    #fi
    #if ( \
    #    [[ "$P" =~ "-muse" ]] || \
    #    false \
    #  ) ; then
    #  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
    #    "-I/opt/local/include/libomp -L/opt/local/lib/libomp"
    #    -e 's@\${compilers.gcc_default}@clang21@' \
    #    ${P}/Portfile"
    #fi
  fi
}
# -----------------------------------------------------------------------------------
add_use_system_wgrib2_variant() {
  if ( \
    [[ "$P" =~ "molecfit_third_party" ]] || \
    false \
  ) ; then
    if ! grep '^variant *use_system_wgrib2' ${P}/Portfile > /dev/null 2>&1 ; then
      # just add it on the end of the Portfile...
      printf "%-40s %s\n" "[${release_channel}.${P}]" "Adding use_system_wgrib2 variant"
cat >>${P}/Portfile <<EOF
variant use_system_wgrib2 description "Use a system version of the wgrib2 package, rather than building the packaged version." {
  post-extract {
    system "tar -xzf \${distpath}/\${__nd__name}-\${version}.tar -C \${workpath}"
    reinplace "s|tar |gnutar |" \${workpath}/\${__nd__name}-\${version}/BuildThirdParty.mk 
    reinplace "s@lnfl lblrtm aer grib2 grib_utils@lnfl lblrtm aer grib_utils@" \${workpath}/\${__nd__name}-\${version}/BuildThirdParty.mk
    reinplace "s@install.*bin/wgrib2@#&@" \${workpath}/\${__nd__name}-\${version}/BuildThirdParty.mk
    reinplace "s@chmod.*bin/wgrib2@#&@" \${workpath}/\${__nd__name}-\${version}/BuildThirdParty.mk
  }
  depends_lib-append port:wgrib2
}
EOF
    fi
  fi
}
# -----------------------------------------------------------------------------------
fix_cfitsio() {
  #_p_cfitsio=$(port file cfitsio 2>/dev/null)
  _p_cfitsio=$(ls macports/ports/science/epl-cfitsio/Portfile 2>/dev/null)
  if [ ! -z ${_p_cfitsio} ]; then
    _revision=$(grep ^revision[[:space:]] ${_p_cfitsio} | awk '{print $2+1}')
    if ! egrep build\.target.\*fpack ${_p_cfitsio} > /dev/null 2>&1 ; then
      notQuietLog "Fixing cfitiso..."
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^build.target.*/& fpack funpack/' \
        -e \"s/^revision[[:space:]].*/revision       ${_revision}/\" \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      if ! grep livecheck.type ${_p_cfitsio} >/dev/null ; then
        # Must be the new version with PortGroup github, thus doesn't need explicit livecheck info
        cat >> ${_p_cfitsio} << EOF

 
variant reentrant description "Enable threads" {__ret__  configure.args -DUSE_PTHREADS=ON__ret__}__ret____ret__
variant sse2 description "Enable sse2" {__ret__  configure.args -DUSE_SSE2=ON__ret__}__ret____ret__
variant ssse3 description "Enable ssse3" {__ret__  configure.args -DUSE_SSE3=ON__ret__}__ret____ret__
variant debug description "Set optimisation level to -Og for debugging, (Macports default is Os)" {__ret__  configure.optflags  -Og -g__ret__}__ret____ret__
EOF
        if ! grep '^PortGroup[[:space:]]*compilers' ${_p_cfitsio} > /dev/null 2>&1 ; then
          execCmd "${EPL_FUNCTIONS_SED} ${meye} \
            -e 's@^PortSystem\(\s\s*\).*@&__ret__PortGroup\1compilers 1.0@' \
            -e 's@^checksums@__ret__compilers.choose  cc cpp cxx fc__ret__compilers.setup   gcc clang__ret____ret__&@' \
            -e 's[__ret__[\\n[g' \
            ${_p_cfitsio}"
        fi
      fi
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^livecheck.type/variant reentrant description \"Enable threads\" {__ret__  configure.args --enable-reentrant__ret__}__ret____ret__&/' \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^livecheck.type/variant sse2 description \"Enable sse2\" {__ret__  configure.args --enable-sse2__ret__}__ret____ret__&/' \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^livecheck.type/variant ssse3 description \"Enable ssse3\" {__ret__  configure.args --enable-ssse3__ret__}__ret____ret__&/' \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's@^livecheck.type@\\nvariant debug description \"Set optimisation level to -Og for debugging, (Macports default is Os)\" {\\n  configure.optflags  -Og -g\\n}\\n\\n&@' \
        ${_p_cfitsio}"
      #
      # By default CFITSIO uses require_fortran and thus has variant +gccXX set
      # So to enable clang compilers, we...
      # 0. add the compilers PortGroup
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/require_fortran/clang gcc/' \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      # 1. replace 'require_fortran' with 'clang gcc'
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/require_fortran/clang gcc/' \
        -e 's[__ret__[\\n[g' \
        ${_p_cfitsio}"
      # 2. set the +gccXX variant 'manually'...
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^livecheck.type/\\ndefault_variants +\${compilers.gcc_default}\\n\\n&/' \
        ${_p_cfitsio}"
      # 3. and append the +reentant variant when the compiler is gccXX or clangYY
      execCmd "${EPL_FUNCTIONS_SED} ${meye} \
        -e 's/^livecheck.type/\\nif {[clang_variant_isset] || [gcc_variant_isset]} {\\n  default_variants-append +reentrant\\n}\\n\\n&/' \
        ${_p_cfitsio}"
    fi
  fi
}
# -----------------------------------------------------------------------------------
keep_edps_wks_in_recipes() {
  printf "%-40s %s\n" "[${release_channel}.${P}]" "Keeping EDPS workflows & reports..."
  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
    -e \"s@system.*/workflows .* uninstall@#&@\" \
    -e \"s@system.*/reports  .* uninstall@#&@\" \
    ${P}/Portfile"
}
# -----------------------------------------------------------------------------------
dont_install_edps_wks_in_wkf() {
  printf "%-40s %s\n" "[${release_channel}.${P}]" "Not installing EDPS workflows & reports..."
  execCmd "${EPL_FUNCTIONS_SED} ${meye} \
    -e \"s@system.*/workflows .* install@#&@\" \
    -e \"s@system.*/reports .* install@#&@\" \
    ${P}/Portfile"
}
# -----------------------------------------------------------------------------------
livecheck_versions() {
  __hdr_done=false
  for _inst in $(
    curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
      | sed \
        -e 's@.*[[:space:]]\([^[:space:]]*-kit-[^[:space:]]*\).*@\1@' \
        -e 's@.*/@@' \
        -e 's@-kit-.*@@' \
  )  ; do
    printf "%15s  %s\n" "${_inst}" "$(port livecheck esopipe-${_inst}-recipes)"
  done
}
# -----------------------------------------------------------------------------------
check_pl_and_cpl_versions() {
  __hdr_done=false
  for _inst in $(
    curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
      | sed \
        -e 's@.*[[:space:]]\([^[:space:]]*-kit-[^[:space:]]*\).*@\1@' \
        -e 's@.*/@@' \
        -e 's@-kit-.*@@' \
  )  ; do
    _kit_version=$(
      curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
        | grep ${_inst}-kit- \
        | sed \
          -e 's@.*[[:space:]]\([^[:space:]]*-kit-[^[:space:]]*\).*@\1@' \
          -e 's@^.*/@@' \
          -e 's@.*-kit-\([0-9a-z\.-]*\).tar.gz@\1@' \
    )
    _demo_version=$(
      curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
        | grep ${_inst}-demo- \
        | sed \
          -e 's@.*[[:space:]]\([^[:space:]]*-demo-[^[:space:]]*\).*@\1@' \
          -e 's@^.*/@@' \
          -e 's@.*-demo-reflex-\([0-9a-z\.-]*\).tar.gz@\1@' \
    )
    # Command to get the CPL version from a PL kit file...
    _cpl_version=$(
      curl -qL $(
        curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
          | sed \
            -e 's@.*[[:space:]]\([^[:space:]]*-kit-[^[:space:]]*\).*@\1@' \
          | grep ${_inst}-kit- \
      ) 2>/dev/null \
        | tar -ztvf - \
        | egrep cpl \
        | sed 's@^.*/@@' \
        | sed -e 's@cpl-\([0-9a-z\.-]*\).tar.gz@\1@' \
        | grep -v .tar.gz \
    )
    # cext is included in cpl tar.gz, not as a separate cext-....-.tar.gz file...
    #
    #! Command to get the PL .tar.gz version from a kit file...
    #! _pl_version correctly reported by livecheck on recipe packages...
    _pl_version=$(
      curl -qL $(
        curl -L https://ftp.eso.org/pub/dfs/pipelines/repositories/${release_channel}/kit/reflex_cfg/reflex_${release_channel}.txt 2>/dev/null \
          | sed \
            -e 's@.*[[:space:]]\([^[:space:]]*-kit-[^[:space:]]*\).*@\1@' \
          | grep ${_inst}-kit- \
      ) 2>/dev/null \
        | tar -ztvf - \
        | grep /${_inst}-\[0-9\] \
        | sed 's@^.*/@@' \
        | sed -e 's@'${_inst}'-\([0-9a-z\.-]*\).tar.gz@\1@' \
        | grep -v .tar.gz \
    )

    if ! ${__hdr_done:-false} ; then
      printf $"%15s  %10s  %10s  %10s  %10s\n" \
        "Instrument" \
        "kit_ver" \
        "demo_ver" \
        "pl_ver" \
        "cpl_ver"
      __hdr_done=true
    fi

    printf "%15s  %10s  %10s  %10s  %10s\n" \
      $_inst \
      $_kit_version \
      $_demo_version \
      $_pl_version \
      $_cpl_version
  done

}
# -----------------------------------------------------------------------------------
check_pl_and_cpl_versions_aem_table() {
  for _inst in $(
    curl -L http://www.eso.org/sci/software/pipe_aem_table.html 2>/dev/null \
      | sed -e 's@</td>@\n@g' \
      | grep href.\*-kit- \
      | sed \
        -e 's@^.*href="@@'\
        -e 's@".*$@@' \
        -e 's@.*/@@' \
        -e 's@-kit-.*@@' \
  )  ; do
    # Command to get the CPL version from a PL kit file...
    _cpl_version=$(
      curl -qL $(
        curl -L http://www.eso.org/sci/software/pipe_aem_table.html 2>/dev/null \
          | sed -e 's@</td>@\n@g' \
          | grep ${_inst}-kit- \
          | sed -e 's@^.*href="@@' -e 's@".*$@@'
      ) 2>/dev/null \
        | tar -ztvf - \
        | grep cpl \
        | sed 's@^.*/@@' \
        | sed -e 's@cpl-\([0-9a-z\.-]*\).tar.gz@\1@' \
        | grep -v .tar.gz \
    )
    # cext is included in cpl tar.gz, not as a separate cext-....-.tar.gz file...
    #
    #! Command to get the PL .tar.gz version from a kit file...
    _pl_version=$(
      curl -qL $(
        curl -L http://www.eso.org/sci/software/pipe_aem_table.html 2>/dev/null \
          | sed -e 's@</td>@\n@g' \
          | grep ${_inst}-kit- \
          | sed -e 's@^.*href="@@' -e 's@".*$@@'
      ) 2>/dev/null \
        | tar -ztvf - \
        | grep /${_inst}-\[0-9\] \
        | sed 's@^.*/@@' \
        | sed -e 's@'${_inst}'-\([0-9a-z\.-]*\).tar.gz@\1@' \
        | grep -v .tar.gz \
    )
    printf "%15s  %8s  %8s\n" $_inst $_pl_version $_cpl_version
  done

}
################################################################################
## Command line options
while [ ! -z "${1}" ]; do

  case $1 in
    -h|--help)    usage ; shift;;
    -D|--debug)   debug="-D"; quiet=""; vbose="-v";  quietLevel=0 ; shift;;
    -n|--dryRun)  dryRun="-n"; shift;;
    -q|--quiet)   quiet="${quiet} -q"; vbose=""; debug=""; (( quietLevel++ )) ; shift;;
    -v|--verbose) vbose="-v"; quiet="";  quietLevel=0 ; shift;;
    -a)           arg="${arg:+$arg }${2}"; shift; shift;;
    -o)           OBXs="${OBXs:+${OBXs} }${2}"; shift; shift;;
    --py)         ESOPIPE_PY_VER="${2}"; shift; shift;;
    *)            exstat=1; usage; shift;;
  esac
done

