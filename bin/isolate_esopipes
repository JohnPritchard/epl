                    cat >>${P}/Portfile <<EOF

patchfiles-append     telluric.m4.diff
EOF
                  fi
# esopipe-gravity-wkf esopipe-hawki-wkf esopipe-muse-contrib-wkf esopipe-sinfo-wkf esopipe-vcam-wkf esopipe-vimos-wkf
                  cat >>${P}/Portfile <<EOF

#pre-patch {
