## For MUSE, unlike the other PLs that support openMP, 
## Because the MUSE code doesn have !defined( *__APPLE__ *) clauses...
## if we DON'T enable
## openMP in HDRL then the muse core gets compiled with openMP support but
## HDRL without and then at run time we get Segmentation Faults.
if {[clang_variant_isset] || [gcc_variant_isset]} {
  default_variants-append +force_omp
}
